# 本番(Supabase等)のPostgres接続文字列。未設定ならローカルSQLiteにフォールバックする。
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_PROJECT.supabase.co:5432/postgres

# JWT署名鍵。本番では必ずランダムな値に変更する（例: python3 -c "import secrets; print(secrets.token_hex(32))"）
LEMONMAP_SECRET_KEY=change-me-to-a-random-secret

# 管理者ログインの初期アカウント（初回起動時、DBに管理者が居ない場合のみ作成される）
LEMONMAP_ADMIN_USER=admin
LEMONMAP_ADMIN_PASSWORD=change-me

# フロントエンドの本番URLをカンマ区切りで指定（例: https://your-app.vercel.app）
# 未設定または "*" の場合は全オリジン許可（開発用）
LEMONMAP_CORS_ORIGINS=*
